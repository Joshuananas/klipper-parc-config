; machine_start_gcode = ; ============================================\n; PRINT METADATA\n; ============================================\n; filament_colour = [filament_colour]\n; filament_type = [filament_type]\n; layer_height = [layer_height]\n; first_layer_height = [initial_layer_print_height]\n; nozzle_diameter = [nozzle_diameter]\n\n; ============================================\n; PRINT START\n; ============================================\n{if curr_bed_type==\"Cool Plate\"}\nPRINT_START EXTRUDER_TEMP=[first_layer_temperature] BED_TEMP=[first_layer_bed_temperature] MATERIAL=[filament_type] BED_SURFACE=COOL LAYER_HEIGHT=[layer_height] COLOR=\"[filament_colour]\"\n{elsif curr_bed_type==\"Engineering Plate\"}\nPRINT_START EXTRUDER_TEMP=[first_layer_temperature] BED_TEMP=[first_layer_bed_temperature] MATERIAL=[filament_type] BED_SURFACE=ENG LAYER_HEIGHT=[layer_height] COLOR=\"[filament_colour]\"\n{elsif curr_bed_type==\"High Temp Plate\"}\nPRINT_START EXTRUDER_TEMP=[first_layer_temperature] BED_TEMP=[first_layer_bed_temperature] MATERIAL=[filament_type] BED_SURFACE=SMOOTH LAYER_HEIGHT=[layer_height] COLOR=\"[filament_colour]\"\n{elsif curr_bed_type==\"Textured PEI Plate\"}\nPRINT_START EXTRUDER_TEMP=[first_layer_temperature] BED_TEMP=[first_layer_bed_temperature] MATERIAL=[filament_type] BED_SURFACE=PEI LAYER_HEIGHT=[layer_height] COLOR=\"[filament_colour]\"\n{else}\nPRINT_START EXTRUDER_TEMP=[first_layer_temperature] BED_TEMP=[first_layer_bed_temperature] MATERIAL=[filament_type] BED_SURFACE=PEI LAYER_HEIGHT=[layer_height] COLOR=\"[filament_colour]\"\n{endif}
